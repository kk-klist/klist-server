# 실제 값은 로컬 또는 배포 서버의 .env 파일에만 작성한다.
SPRING_PROFILES_ACTIVE=prod

# PostgreSQL
DB_URL=jdbc:postgresql://db-host:5432/klist
DB_USERNAME=
DB_PASSWORD=
DDL_AUTO=update

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# OAuth2
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_CLIENT_REDIRECT_URI=https://example.com/oauth/callback

# JWT
JWT_SECRET=
JWT_ACCESS_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=1209600000

# 외부 API
TOUR_SERVICE_KEY=
WEATHER_API_KEY=
KAKAO_REST_KEY=
KAKAO_ADMIN_KEY=

# 클라이언트 접근 주소
CORS_ALLOWED_ORIGINS=https://example.com

# 챗봇
CHATBOT_BASE_URL=http://chatbot:8081
INTERNAL_API_KEY=
CHATBOT_HTTP_TIMEOUT_MS=35000
